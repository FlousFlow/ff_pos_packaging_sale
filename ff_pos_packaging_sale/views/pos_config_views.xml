<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_config_view_form_ff_pos_packaging" model="ir.ui.view">
        <field name="name">pos.config.form.pos.packaging.sale</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='configuration']" position="inside">
                <group string="Packaging Sale" name="ff_packaging_sale">
                    <field name="ff_packaging_selection_behavior"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
