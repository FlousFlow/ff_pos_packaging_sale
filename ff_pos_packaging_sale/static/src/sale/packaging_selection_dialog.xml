<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="ff_pos_packaging_sale.SalePackagingSelectionDialog">
        <Dialog title="'Choose a selling unit'">
            <div class="d-flex flex-column gap-2 p-2">
                <button t-foreach="this.props.choices" t-as="choice" t-key="choice.id"
                        class="btn btn-outline-secondary text-start py-3"
                        t-on-click="() => this.select(choice)">
                    <span class="fw-bold" t-esc="choice.name"/>
                    <span t-if="choice.contained &gt; 1" class="text-muted ms-2"
                          t-esc="'(' + choice.contained + ' units)'"/>
                </button>
            </div>
        </Dialog>
    </t>
</templates>
